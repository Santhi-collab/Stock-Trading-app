# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/sbstocks

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Stock data
# Get a free key at https://finnhub.io/ - if left blank, the app
# automatically falls back to a realistic simulated feed so you can
# still develop and demo without a key.
FINNHUB_API_KEY=

# Starting virtual cash balance for new users
STARTING_BALANCE=100000
